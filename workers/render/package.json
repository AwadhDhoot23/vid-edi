{
  "name": "@vid-edi/worker-render",
  "version": "0.1.0",
  "private": true,
  "description": "Background video render worker using native FFmpeg with real-time progress and preset encoding",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vid-edi/media-processing": "workspace:*",
    "@vid-edi/shared-types": "workspace:*",
    "bullmq": "^5.41.0",
    "ioredis": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@vid-edi/config": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
