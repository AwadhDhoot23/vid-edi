{
  "name": "@vid-edi/media-processing",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic media processing utilities, FFprobe/FFmpeg wrappers, and WebCodecs helpers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vid-edi/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@vid-edi/config": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
