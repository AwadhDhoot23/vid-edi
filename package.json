{
  "name": "vid-edi",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, AI-assisted video editor with natural-language commands and deterministic rendering",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
